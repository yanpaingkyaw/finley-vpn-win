{
  "name": "finley-vpn",
  "version": "1.1.0",
  "private": true,
  "description": "Finley Windows VPN client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env FINLEY_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-service.ps1",
    "test": "node --test tests/*.test.cjs",
    "test:native": "npm run build:native && node --test tests/service-native.test.cjs",
    "dist": "npm run build:native && npm test && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.finley.vpn",
    "productName": "Finley",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/finley-icon.*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "sing-box.exe",
          "finley-tunnel-helper.exe",
          "finley-tunnel-service.exe",
          "finley-service-client.exe",
          "SING-BOX-LICENSE.txt"
        ]
      }
    ]
  }
}
